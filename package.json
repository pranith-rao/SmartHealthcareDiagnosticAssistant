{
  "name": "team-cursorminds-healthcare-assistant",
  "version": "1.0.0",
  "description": "Smart Healthcare Diagnostic Assistant - Backend Medical Decision Support System",
  "main": "src/backend/server.js",
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "nodemon src/backend/server.js",
    "client": "cd src/frontend && npm start",
    "client:build": "cd src/frontend && npm run build",
